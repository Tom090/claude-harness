# .claude/harness.env — the harness plugin dogfooding itself. Plain KEY="value" lines,
# read literally by the hooks and scripts (never sourced). Safe to commit; no secrets.
#
# The Stop gate and stream.sh only act when this repo's absolute path is listed in
# ~/.config/claude-harness/trusted-projects (user-level, outside the repo).

PROJECT_NAME="claude-harness"

# The plugin has no test suite; the citation check is its gate.
TEST_COMMAND="bash plugins/harness/scripts/check-citations.sh plugins/harness"
BUILD_RELEVANT_PATTERNS="plugins/harness/"
DEFAULT_BRANCH="main"

# Work streams in containers: used by /harness:verify-gates §6 against this repo.
STREAM_RUNS_DIR=".claude/streams"
STREAM_REPO="Tom090/claude-harness"
STREAM_BASE_IMAGE="node:20"
STREAM_SETUP_COMMAND=""
STREAM_MAX_CONCURRENT="2"
STREAM_MAX_TURNS="40"
STREAM_MAX_BUDGET_USD="10"
