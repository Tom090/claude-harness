# .claude/harness.env — per-project config for the harness plugin's hooks/scripts.
#
# Written once by /harness:harness-init; hand-edit freely afterwards. Plain KEY=VALUE,
# sourced by bash — quote values with spaces. This file is NOT a secrets file (no
# tokens/keys belong here — see skills/ask-owner/SKILL.md for where Telegram secrets
# live); it's safe to commit.
#
# CRITICAL: both bundled hooks (stop-test-gate, block-destructive-bash) are no-ops until
# this file exists with at least TEST_COMMAND set — that's what keeps the plugin inert
# in a project that hasn't been bound yet.

# Free-text name used for display and for the Telegram secrets path
# (~/.config/<PROJECT_NAME>-harness/telegram.env). Required for the ask-owner skill;
# not required by the hooks.
PROJECT_NAME="my-project"

# Required for the Stop hook to do anything. Whatever this project's real test+lint
# command is; keep it to the fast/debug/scoped variant, not every target.
# Examples:
#   TEST_COMMAND="./gradlew testDebugUnitTest lintDebug"
#   TEST_COMMAND="npm test && npm run lint"
#   TEST_COMMAND="cargo test && cargo clippy -- -D warnings"
#   TEST_COMMAND="pytest -q && ruff check ."
TEST_COMMAND="./run-tests.sh"

# Optional: separate lint-only command, used by the /harness:validate skill if your
# lint step is meaningfully separate from TEST_COMMAND (e.g. an autofix pass).
LINT_COMMAND=""

# Optional: space-separated path prefixes that mean "this session touched code worth
# gating on" — matched against the session's changed files (working tree + staged +
# committed-since-branch-point + untracked). If unset, the Stop hook gate always runs
# when there are ANY changed files (conservative default, no false skips). Set this to
# skip the gate on docs-only / non-code sessions.
# Example (a JS monorepo): BUILD_RELEVANT_PATTERNS="src/ package.json package-lock.json"
BUILD_RELEVANT_PATTERNS=""

# Optional: the branch check-test-weakening.sh and the Stop hook diff against when no
# explicit ref is given. Defaults to "main".
DEFAULT_BRANCH="main"

# Optional: extra colon-separated bash `case` glob patterns treated as "test-relevant"
# by check-test-weakening.sh, beyond its generic *test*/*spec*/*fixture*/*corpus*
# defaults. Example: TEST_RELEVANT_PATTERNS="firestore-tests/fixtures/*.json"
TEST_RELEVANT_PATTERNS=""

# Optional: extra pipe-separated grep -Ei alternatives that count as a "ruling
# reference" in a PR body for check-test-weakening.sh, beyond the generic defaults
# (owner ruling, ruling:, decisions.md, ratified).
RULING_KEYWORDS=""

# Optional: space-separated path prefixes that must NEVER be an `rm -rf` target,
# checked by block-destructive-bash.sh regardless of anything else in the command.
# Example: PROTECTED_PATHS="secrets .env keystore.jks"
PROTECTED_PATHS=""
