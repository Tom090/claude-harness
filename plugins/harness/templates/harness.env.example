# .claude/harness.env — per-project config for the harness plugin's hooks/scripts.
#
# Written once by /harness:harness-init; hand-edit freely afterwards. Plain KEY="value",
# one per line, read literally (never sourced): no shell expressions, no trailing
# comments on a value line. This file is NOT a secrets file (no
# tokens/keys belong here — see skills/ask-owner/SKILL.md for where Telegram secrets
# live); it's safe to commit.
#
# TRUST MODEL: this file is inside the repo, and the Stop gate runs TEST_COMMAND. So the
# file alone is never enough — the gate additionally requires this project's absolute path
# to be listed in ~/.config/claude-harness/trusted-projects, a user-level file outside any
# repo. Cloning a repo that ships a harness.env therefore executes nothing; only a path
# you (or /harness:harness-init, on your behalf, in this repo) added is ever run. The
# hooks READ this file literally and never `source` it, so no value here executes either.
#
# CRITICAL: both bundled hooks are no-ops until this file exists — that's what keeps the
# plugin inert in a project that hasn't been bound yet. block-destructive-bash activates
# as soon as the file exists (TEST_COMMAND irrelevant to it); stop-test-gate additionally
# needs TEST_COMMAND set, and stays silent without it.

# Free-text name used for display and for the Telegram secrets path
# (~/.config/<PROJECT_NAME>-harness/telegram.env). Required for the ask-owner skill;
# not required by the hooks.
PROJECT_NAME="my-project"

# Required for the Stop hook to do anything. This project's real, full test+lint command:
# /harness:validate runs it once per PR, and the Stop gate runs it per turn only when
# SCOPED_TEST_COMMAND below is unset.
# Examples:
#   TEST_COMMAND="./gradlew testDebugUnitTest lintDebug"
#   TEST_COMMAND="npm test && npm run lint"
#   TEST_COMMAND="cargo test && cargo clippy -- -D warnings"
#   TEST_COMMAND="pytest -q && ruff check ."
TEST_COMMAND="./run-tests.sh"

# STRONGLY RECOMMENDED when several agents share a machine. The Stop gate runs this at
# the end of each turn instead of TEST_COMMAND. `{files}` is replaced by the session's
# changed, still-existing files (those matching BUILD_RELEVANT_PATTERNS when set), each
# shell-quoted; a command without `{files}` runs as written. When the file list is empty
# (deletions only) the gate falls back to TEST_COMMAND. TEST_COMMAND stays the full
# suite, run once by /harness:validate at PR time. Examples:
#   SCOPED_TEST_COMMAND="npx vitest related --run {files}"
#   SCOPED_TEST_COMMAND="npx jest --findRelatedTests {files}"
#   SCOPED_TEST_COMMAND="npx vitest run --changed main"
SCOPED_TEST_COMMAND=""

# Optional: separate lint-only command, used by the /harness:validate skill if your
# lint step is meaningfully separate from TEST_COMMAND (e.g. an autofix pass).
LINT_COMMAND=""

# STRONGLY RECOMMENDED: space-separated path fragments meaning "this session touched code
# worth gating on" — matched as fixed strings (substring, not glob) against the session's
# changed files (working tree + staged + committed-since-branch-point + untracked). If
# unset, the Stop gate runs the full TEST_COMMAND at the end of every turn that changed
# ANY file, docs included (a clean tree still skips). Set this so docs-only and
# harness-only sessions don't pay for a test run.
# Example (a JS monorepo): BUILD_RELEVANT_PATTERNS="src/ package.json package-lock.json"
BUILD_RELEVANT_PATTERNS=""

# Optional: the branch check-test-weakening.sh and the Stop hook diff against when no
# explicit ref is given. Defaults to "main".
DEFAULT_BRANCH="main"

# Optional: extra colon-separated bash `case` glob patterns treated as "test-relevant"
# by check-test-weakening.sh, beyond its generic *test*/*spec*/*fixture*/*corpus*
# defaults. Example: TEST_RELEVANT_PATTERNS="e2e/data/*.json:golden/*"
TEST_RELEVANT_PATTERNS=""

# Optional: extra pipe-separated grep -Ei alternatives that count as a "ruling
# reference" in a PR body for check-test-weakening.sh, beyond the generic defaults
# (owner ruling, ruling:, decisions.md, ratified).
RULING_KEYWORDS=""

# Optional: space-separated path prefixes that must NEVER be an `rm -rf` target,
# checked by block-destructive-bash.sh regardless of anything else in the command.
# That hook does NOT source this file (it runs on every Bash call in every enabled
# project); it reads this key literally, so write it as a plain quoted KEY="value" on one
# line — no shell expressions, and no trailing comment on the same line.
# Example: PROTECTED_PATHS="secrets .env keystore.jks"
PROTECTED_PATHS=""

# ---------------------------------------------------------------------------------------
# Work streams in containers (scripts/stream.sh). Every key optional; defaults shown.
# One container per issue runs a headless stream lead with the full harness; the only
# channels back are the PR and <STREAM_RUNS_DIR>/<issue>-<slug>/result.json. Secrets are
# NOT here: ~/.config/claude-harness/containers.env holds CLAUDE_CODE_OAUTH_TOKEN (from
# `claude setup-token`) and ~/.config/<PROJECT_NAME>-harness/containers.env holds GH_TOKEN
# (a fine-grained PAT on this one repo: Contents, Pull requests, Issues read/write).
# Both mode 0600; neither may set ANTHROPIC_API_KEY (it would override the OAuth token).

# Where run dirs live, relative to the project root. Add it to .gitignore.
STREAM_RUNS_DIR=".claude/streams"

# owner/name the container clones over HTTPS with GH_TOKEN. Default: `gh repo view`.
STREAM_REPO=""

# Base image for the stream image; match .nvmrc's major (e.g. node:24). Default node:20.
STREAM_BASE_IMAGE=""

# Pinned Claude Code version inside the image. Default: the host CLI's version.
STREAM_CLAUDE_VERSION=""

# Run once after the clone, before the stream lead starts. Default: "npm ci" when a
# package-lock.json exists, else nothing.
STREAM_SETUP_COMMAND=""

# Cap on simultaneously active streams; launch refuses above it. A stream counts as
# one or two gate-running agents (its lead plus a builder) against the four-or-five
# per-machine rule, so 3 is the default and 2 is right for a project whose Stop gate
# runs the full suite every turn.
STREAM_MAX_CONCURRENT="3"

# docker run --memory / --cpus per container.
STREAM_MEMORY="6g"
STREAM_CPUS="3"

# Default caps for the stream lead (claude -p --max-budget-usd / --max-turns), overridable
# per launch with --budget / --max-turns. Empty = no cap.
STREAM_MAX_BUDGET_USD=""
STREAM_MAX_TURNS=""

# Stream lead model and effort (--model / --effort). The stream lead is a judgment role,
# so the default is opus; builders keep the model their agent definitions pin.
STREAM_MODEL="opus"
STREAM_EFFORT=""

# stream.sh stop: seconds to wait after SIGINT before docker stop drops the turn.
STREAM_STOP_GRACE_SECS="300"

# Egress firewall inside the container (GitHub, Anthropic, npm registry only). "0"
# disables it, for debugging only. STREAM_EXTRA_EGRESS adds hostnames, space-separated.
STREAM_FIREWALL="1"
STREAM_EXTRA_EGRESS=""

# MCP is off inside a stream (--strict-mcp-config) unless this names a config file path
# or JSON string to pass as --mcp-config.
STREAM_MCP_CONFIG=""

# stream.sh collect --wait gives up after this many seconds.
STREAM_COLLECT_TIMEOUT_SECS="28800"
